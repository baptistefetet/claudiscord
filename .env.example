# Your Discord user ID (enable Developer Mode in Discord → right-click your
# avatar → "Copy User ID"). The bot ignores every other user.
AUTHORIZED_USER_ID=

# Discord bot token (from the Discord Developer Portal).
DISCORD_TOKEN=

# Optional: absolute path to the Claude Code CLI on the host. Defaults
# to ~/.local/bin/claude (where claude.ai/install.sh drops the binary
# for the user running the service). Override only if it lives elsewhere.
CLAUDE_BIN=

# Optional: directory bind-mounted into the sandbox container as
# /home/claude. Holds the user's CLAUDE.md, credentials, sessions and
# sandbox jobs. Leave empty if you only want admin mode.
SANDBOX_HOME=

# Optional: Groq API key (https://console.groq.com/keys) to transcribe
# Discord voice messages via Whisper before forwarding to Claude. Leave
# empty to ignore voice messages entirely.
GROQ_API_KEY=

# Optional: Groq Whisper model id. Defaults to whisper-large-v3 (highest
# quality). whisper-large-v3-turbo is faster but slightly less accurate.
STT_MODEL=

# Optional: transcription language (ISO-639-1). Defaults to "fr". Setting
# the language improves both accuracy and latency.
STT_LANGUAGE=

# Optional: OpenAI API key (https://platform.openai.com/api-keys) for the
# voice assistant's text-to-speech. Leave empty to disable /voice.
OPENAI_API_KEY=

# Optional: OpenAI TTS model id. Defaults to gpt-4o-mini-tts.
TTS_MODEL=

# Optional: OpenAI TTS voice. Defaults to ash.
TTS_VOICE=

# Optional: speech rate multiplier, 0.25-4.0. Defaults to 1.
TTS_SPEED=

# GitHub personal access token with the `gist` scope
# (https://github.com/settings/tokens). Required by /diff, which publishes the
# patch as a secret gist and refuses to run without it. One gist per channel,
# rewritten on every run, each report linked by its revision.
# Note: a secret gist is unlisted, not private — anyone with the URL can read it,
# and /diff shows uncommitted work.
GITHUB_TOKEN=
