# Your Discord user ID. Leave empty to auto-register the author of the first
# DM the bot receives (convenient for first-time setup).
AUTHORIZED_USER_ID=

# Discord bot token (from the Discord Developer Portal).
DISCORD_TOKEN=

# Absolute path to the Claude Code CLI on the host (used in admin mode).
CLAUDE_BIN=

# Optional: directory bind-mounted into the sandbox container as
# /home/claude. Holds the user's CLAUDE.md, credentials, sessions and
# sandbox jobs. Leave empty if you only want admin mode.
SANDBOX_HOME_DIR=
